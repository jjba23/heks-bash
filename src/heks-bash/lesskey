# ====== pager keymap ======
#
# Generated from bash-pager-keymap in bash.scm: edit the Scheme list, not this
# file.  Installed as $XDG_CONFIG_HOME/lesskey, which less(1) 582 and later
# read directly, so there is no `lesskey' compile step and no binary to keep in
# sync.  Everything not listed here keeps its default less binding (j k space b
# g G / ? n N m ' ! | :x q ...), so both muscle memories work.

#command
# one line down / up
^N forw-line
^P back-line

# one screen down / up
^F forw-screen
^B back-screen
^V forw-screen
\ev back-screen

# half a screen down / up
^D forw-scroll
^U back-scroll

# RET scrolls a line too
\r forw-line
\n forw-line

# top / bottom of the file
^A goto-line 1\rk
\e< goto-line 1\rk
^E goto-end
\e> goto-end

# go to a line
\eg goto-line

# redraw the screen
^L repaint

# search forward / backward
^S forw-search
^R back-search

# clear the search highlighting
\eU clear-search

# the status line
^G status

#line-edit
# beginning / end of the line
^A home
^E end
\e0 home
\e$ end

# one character left / right
^B left
^F right
\eh left
\el right

# one word left / right
\eb word-left
\ef word-right

# kill the word before the cursor
^W word-backspace
\kB word-backspace
\e\kb word-backspace

# delete / kill
^D delete
\ed word-delete
^K kill-line
^U kill-line

# previous / next line
^P up
^N down

# cancel the prompt
^G abort

# complete a file name
\e\t back-complete
